[Unit]
Description=MQTT Client Script
After=network.target

[Service]
Type=simple
User=your_username
WorkingDirectory=/root/Source/mqtt-listener-and-code-executer/
TimeoutStartSec=180
ExecStartPre=/bin/sleep 60
ExecStart=/usr/bin/python3 -u /root/Source/mqtt-listener-and-code-executer/mqtt-listener.py -c /root/Source/mqtt-listener-and-code-executer/commands.txt
Restart=always

[Install]
WantedBy=multi-user.target
